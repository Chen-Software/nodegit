# npm 12 defaults `allow-git` to "none" and refuses to fetch git-based
# dependencies (error EALLOWGIT). nodegit intentionally depends on its own
# patched nan fork via a git ref (see package.json), so opt in for
# root-declared git dependencies only. Transitive git dependencies remain
# blocked, which keeps the supply-chain protection in place.
allow-git=root
